        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import os\n",
        "\n",
        "# 1. LOAD DATA\n",
        "file_list = os.listdir()\n",
        "sentiment_file = next((f for f in file_list if 'greed' in f.lower() and f.endswith('.csv')), None)\n",
        "trader_file = next((f for f in file_list if 'historical' in f.lower() and f.endswith('.csv')), None)\n",
        "\n",
        "if not sentiment_file or not trader_file:\n",
        "    print(\"Files not found. Ensure both CSVs are in the folder.\")\n",
        "else:\n",
        "    # Read files\n",
        "    sentiment_df = pd.read_csv(sentiment_file)\n",
        "    trader_df = pd.read_csv(trader_file, low_memory=False)\n",
        "\n",
        "    # 2. CLEAN COLUMN NAMES\n",
        "    sentiment_df.columns = sentiment_df.columns.str.strip().str.lower()\n",
        "    trader_df.columns = trader_df.columns.str.strip().str.lower()\n",
        "\n",
        "    # 3. STANDARDIZE DATES\n",
        "    # Sentiment Date\n",
        "    sent_date_col = 'date' if 'date' in sentiment_df.columns else sentiment_df.columns[0]\n",
        "    sentiment_df['clean_date'] = pd.to_datetime(sentiment_df[sent_date_col]).dt.date\n",
        "\n",
        "    # Trader Date (Using 'timestamp' as it's the standard Unix format)\n",
        "    # Hyperliquid timestamps are in milliseconds\n",
        "    trader_df['clean_date'] = pd.to_datetime(trader_df['timestamp'], unit='ms', errors='coerce').dt.date\n",
        "\n",
        "    # 4. MERGE DATASETS\n",
        "    df = pd.merge(trader_df, sentiment_df, on='clean_date', how='inner')\n",
        "\n",
        "    # 5. DEFINE EXACT COLUMNS FROM YOUR DATA\n",
        "    # Based on your printout: 'closed pnl' and 'classification'\n",
        "    pnl_col = 'closed pnl'\n",
        "    class_col = 'classification'\n",
        "\n",
        "    # Convert PnL to numeric\n",
        "    df[pnl_col] = pd.to_numeric(df[pnl_col], errors='coerce').fillna(0)\n",
        "\n",
        "    # 6. ANALYZE PERFORMANCE\n",
        "    performance = df.groupby(class_col).agg({\n",
        "        pnl_col: ['mean', 'sum', 'count']\n",
        "    }).reset_index()\n",
        "    performance.columns = ['Sentiment', 'Avg_PnL', 'Total_PnL', 'Trade_Count']\n",
        "\n",
        "    # 7. VISUALIZE\n",
        "    plt.figure(figsize=(14, 6))\n",
        "\n",
        "    # Plot 1: Average Profitability\n",
        "    plt.subplot(1, 2, 1)\n",
        "    sns.barplot(data=performance, x='Sentiment', y='Avg_PnL', palette='viridis')\n",
        "    plt.title('Avg Profit per Trade vs Market Sentiment')\n",
        "    plt.ylabel('Mean Closed PnL ($)')\n",
        "    plt.xticks(rotation=45)\n",
        "\n",
        "    # Plot 2: Trading Activity (Volume of trades)\n",
        "    plt.subplot(1, 2, 2)\n",
        "    sns.barplot(data=performance, x='Sentiment', y='Trade_Count', palette='magma')\n",
        "    plt.title('Number of Trades vs Market Sentiment')\n",
        "    plt.ylabel('Total Executions')\n",
        "    plt.xticks(rotation=45)\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "    # 8. FINAL INSIGHTS FOR SUBMISSION\n",
        "    print(\"\\n\" + \"=\"*60)\n",
        "    print(\"FINAL ASSIGNMENT REPORT\")\n",
        "    print(\"=\"*60)\n",
        "\n",
        "    best_phase = performance.loc[performance['Avg_PnL'].idxmax()]\n",
        "    most_active = performance.loc[performance['Trade_Count'].idxmax()]\n",
        "\n",
        "    print(f\"INSIGHT 1: Profitability Peak\")\n",
        "    print(f\"Traders are most profitable during '{best_phase['Sentiment']}' phases.\")\n",
        "    print(f\"Average PnL: ${best_phase['Avg_PnL']:.2f} per trade.\")\n",
        "    print(\"-\" * 30)\n",
        "    print(f\"INSIGHT 2: Market Euphoria vs Reality\")\n",
        "    print(f\"The highest trading volume ({most_active['Trade_Count']} trades) occurs during '{most_active['Sentiment']}'.\")\n",
        "    print(\"-\" * 30)\n",
        "    print(f\"INSIGHT 3: Hidden Pattern\")\n",
        "    # Calculating if people lose more in Greed\n",
        "    greed_pnl = performance[performance['Sentiment'].str.contains('Greed', na=False)]['Avg_PnL'].mean()\n",
        "    fear_pnl = performance[performance['Sentiment'].str.contains('Fear', na=False)]['Avg_PnL'].mean()\n",
